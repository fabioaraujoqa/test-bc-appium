{
  "mcpServers": {
    "appium-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "appium-mcp@1.95.1"],
      "env": {
        "ANDROID_HOME": "${ANDROID_HOME}",
        "CAPABILITIES_CONFIG": "./tests/config/appium-mcp.capabilities.json",
