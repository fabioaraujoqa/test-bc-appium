# Modelo de todas as chaves dos perfis do projeto bc (sem valores).
# .env.bc            -> perfil padrão (emulador Android)
# .env.bc.<perfil>   -> overlay de celular | tablet | simulador (só o que muda)
# Os arquivos .env.bc* reais ficam fora do git; este .example é versionado.

# ===== Dispositivo =====
# emulador | celular | tablet | simulador
# DEVICE_PROFILE=

# Android: UDID do `adb devices` (obrigatório em celular/tablet)
# ANDROID_UDID=
# Android: AVD que o Appium sobe se o emulador não estiver rodando (perfil emulador)
# ANDROID_AVD=
# ANDROID_PLATFORM_VERSION=

# iOS: nome e versão do simulador (`xcrun simctl list devices available`)
# IOS_DEVICE_NAME=
# IOS_PLATFORM_VERSION=
# IOS_UDID=

# ===== Appium (porta única por perfil) =====
# APPIUM_PORT=
# Android: porta do UiAutomator2
# SYSTEM_PORT=
# iOS: porta do WebDriverAgent
# WDA_LOCAL_PORT=

# ===== WebdriverIO =====
# MOCHA_TIMEOUT=
# WAIT_TIMEOUT=
# CONNECTION_RETRY_TIMEOUT=
# CONNECTION_RETRY_COUNT=
# LOG_LEVEL=

# ===== Relatórios e evidências =====
# TEST_RESULTS_DIR=
# SCREENSHOT_DIR=
# ALLURE_REPORTER=
