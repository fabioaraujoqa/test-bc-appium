# Copie para .env e preencha. O .env fica fora do git; este modelo é versionado.
# Só entra aqui o que é SEGREDO ou muda POR MÁQUINA. Portas, timeouts e regras de cada
# perfil (emulador | celular | tablet | simulador) estão em config/env.loader.js.
# Qualquer chave também pode vir do terminal, que tem precedência: CELULAR_UDID=xxx npm run test:celular

# ===== BrowserStack (npm run bs-android) =====
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
# app_url (bs://...) ou custom_id devolvido no upload do .apk
BROWSERSTACK_APP_ID=
# idem para o .ipa (iOS em aparelho real precisa de build assinado, não o .app de simulador)
BROWSERSTACK_APP_ID_IOS=

# ===== Usuário de login do app (specs de login) =====
# A massa de cadastro (válida e inválida) fica em tests/fixtures/usuarios.json
LOGIN_EMAIL=
LOGIN_SENHA=

# ===== Aparelhos desta máquina =====
# AVD do perfil emulador (npm run list:emulators). Padrão: Pixel_5
ANDROID_AVD=
# UDID do emulador no adb. Padrão: emulator-5554
EMULADOR_UDID=
# UDID do celular físico (adb devices). Obrigatório só para DEVICE_PROFILE=celular
CELULAR_UDID=
# UDID do tablet físico (adb devices). Obrigatório só para DEVICE_PROFILE=tablet
TABLET_UDID=
# Simulador iOS (xcrun simctl list devices available). Padrão: iPhone 16 / 18.5
IOS_DEVICE_NAME=
IOS_PLATFORM_VERSION=
# Opcional: fixa o simulador pelo UDID em vez do nome
IOS_UDID=

# ===== Ajustes opcionais (padrões no código) =====
# Perfil usado quando não vier do terminal. Padrão: emulador
DEVICE_PROFILE=
# error | warn | info | debug. Padrão: warn
LOG_LEVEL=
# false desliga o Allure. Padrão: true
ALLURE_REPORTER=
